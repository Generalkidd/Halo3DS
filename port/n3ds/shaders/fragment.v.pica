; Emit every enabled output lane exactly once on each execution path.
; Native fragment-lighting probe. Packed outputs leave room for cube/base/mask.
.fvec projection[4]
.constf constants(0.0, 1.0, 0.5, 0.00000001)
.out position position
.out color color
.out cube texcoord0.xy
.out - texcoord0w cube.z
.out maps texcoord1.xy
.out - texcoord2 maps.zw
.out quaternion normalquat
.out view view
.proc main
    mov r0.xyz, v0
    mov r0.w, constants.y
    dp4 position.x, projection[0], r0
    dp4 position.y, projection[1], r0
    dp4 position.z, projection[2], r0
    dp4 position.w, projection[3], r0
    mov view, -r0
    ; Unit normal -> quaternion rotating the positive Z axis onto the normal.
    dp3 r1.w, v1, v1
    max r1.w, constants.w, r1.w
    rsq r1.w, r1.w
    mul r1.xyz, v1, r1.w
    mov r2.xy, r1
    add r2.z, constants.y, r1.z
    mov r2.w, constants.x
    dp3 r3.x, r2, r2
    mov r9, constants.yxxx
    cmp constants.w, ge, ge, r3.x
    jmpc cmp.x, done_normal
    rsq r3.x, r3.x
    mul r9, r2, r3.x
done_normal:
    mov quaternion, r9
    mov color, constants.yyyy
    mov cube, v2
    mov maps.xy, v2
    mov maps.zw, v2.xyxy
    end
.end
