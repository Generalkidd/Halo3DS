; Original little-endian ARGB8 vertices. Byte conversion and view-to-world
; projection happen on PICA; the CPU retains sorting and particle simulation.
.fvec projection[4]
.constf constants(0.0, 0.0, 0.00392156862745098, 1.0)
.out position position
.out color color
.out texcoord texcoord0
.out neutral1 texcoord1
.out neutral2 texcoord2
.proc main
    mov r0.xyz, v0
    mov r0.w, constants.w
    dp4 position.x, projection[0], r0
    dp4 position.y, projection[1], r0
    dp4 position.z, projection[2], r0
    dp4 position.w, projection[3], r0
    mul color, constants.z, v2.zyxw
    mov texcoord, v1
    mov neutral1, constants.xxxx
    mov neutral2, constants.xxxx
    end
.end
