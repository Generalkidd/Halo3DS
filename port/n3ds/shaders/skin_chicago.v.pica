; Animated Chicago maps and model skinning in one native vertex pass.
.fvec projection[4]
.fvec bone[84]
.fvec uv_rows[6]
.constf constants(0,0,0,1)
.out position position
.out color color
.out uv0 texcoord0
.out uv1 texcoord1
.out uv2 texcoord2
.proc main
    mov r0.xyz, v0
    mov r0.w, constants.w
    mova a0.xy, v3
    dp4 r1.x, bone[a0.x+0], r0
    dp4 r1.y, bone[a0.x+1], r0
    dp4 r1.z, bone[a0.x+2], r0
    ; Single-influence vertices skip the unused transform and blend.
    cmp constants.x, ge, ge, v3.w
    jmpc cmp.x, skin_complete
    dp4 r4.x, bone[a0.y+0], r0
    dp4 r4.y, bone[a0.y+1], r0
    dp4 r4.z, bone[a0.y+2], r0
    mul r1.xyz, v3.z, r1
    mul r4.xyz, v3.w, r4
    add r1.xyz, r1, r4
skin_complete:
    mov r1.w, constants.w
    dp4 position.x, projection[0], r1
    dp4 position.y, projection[1], r1
    dp4 position.z, projection[2], r1
    dp4 position.w, projection[3], r1
    mov color, constants.wwww
    mov r0.xy, v2
    mov r0.zw, constants
    dp4 uv0.x, uv_rows[0], r0
    dp4 uv0.y, uv_rows[1], r0
    mov uv0.zw, constants
    dp4 uv1.x, uv_rows[2], r0
    dp4 uv1.y, uv_rows[3], r0
    mov uv1.zw, constants
    dp4 uv2.x, uv_rows[4], r0
    dp4 uv2.y, uv_rows[5], r0
    mov uv2.zw, constants
    end
.end
