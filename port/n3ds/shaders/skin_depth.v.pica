; Position-only depth pass: no normal, lighting, reflection or UV calculations.
.fvec projection[4]
.fvec bone[87]
.constf constants(0,0,0,1)
.out position position
.out color color
.out texcoord texcoord0
.proc main
    mov r0.xyz, v0
    mov r0.w, constants.w
    mova a0.xy, v3
    dp4 r1.x, bone[a0.x+0], r0
    dp4 r1.y, bone[a0.x+1], r0
    dp4 r1.z, bone[a0.x+2], r0
    ; Single-influence vertices skip the unused transform and blend.
    cmp constants.x, ge, ge, v3.w
    jmpc cmp.x, skin_complete
    dp4 r4.x, bone[a0.y+0], r0
    dp4 r4.y, bone[a0.y+1], r0
    dp4 r4.z, bone[a0.y+2], r0
    mul r1.xyz, v3.z, r1
    mul r4.xyz, v3.w, r4
    add r1.xyz, r1, r4
skin_complete:
    mov r1.w, constants.w
    dp4 position.x, projection[0], r1
    dp4 position.y, projection[1], r1
    dp4 position.z, projection[2], r1
    dp4 position.w, projection[3], r1
    mov color, constants.wwww
    mov texcoord, constants.xxxx
    end
.end
