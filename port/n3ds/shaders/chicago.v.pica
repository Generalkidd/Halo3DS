.fvec projection[4]
.constf constants(0.0, 0.0, 0.0, 1.0)
.out position position
.out color color
.out uv0 texcoord0.xy
.out - texcoord0w uv0.z
.out uv1 texcoord1
.out uv2 texcoord2
.proc main
    mov r0.xyz, v0
    mov r0.w, constants.w
    dp4 position.x, projection[0], r0
    dp4 position.y, projection[1], r0
    dp4 position.z, projection[2], r0
    dp4 position.w, projection[3], r0
    mov color, v4
    mov uv0.xy, v1
    mov uv0.z, v3.x
    mov uv0.w, constants.w
    mov uv1, v2
    mov uv2, v3
    end
.end
