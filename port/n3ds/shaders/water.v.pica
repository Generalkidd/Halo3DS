; Emit every enabled output lane exactly once on each execution path.
; Posed world position, animated world normal and base UV. Texture sampling,
; normalization, eye reflection and facing tint are evaluated by PICA.
.fvec projection[4]
.fvec camera
.fvec fallback_eye
.fvec delta
.fvec parallel
.fvec wave_phase
.fvec wave_switch
.constf constants(0.0, 1.0, 2.0, 0.000000000001)
.out position position
.out color color
.out cube texcoord0.xy
.out - texcoord0w cube.z
.out maps texcoord1.xy
.proc main
    mov r0.xyz, v0
    mov r0.w, constants.y
    dp4 position.x, projection[0], r0
    dp4 position.y, projection[1], r0
    dp4 position.z, projection[2], r0
    dp4 position.w, projection[3], r0
    mov r2.xyz, v1
    mov r1.w, wave_switch.x
    cmp constants.x, ge, ge, r1.w
    jmpc cmp.x, wave_ready
    mul r5, wave_phase, v3
    add r1.x, r5.x, r5.y
    add r1.y, r5.z, r5.w
    add r2.xy, r2, r1
wave_ready:
    dp3 r1.x, r2, r2
    max r1.x, constants.w, r1.x
    rsq r1.x, r1.x
    mul r2.xyz, r2, r1.x
    add r3.xyz, camera, -r0
    dp3 r1.y, r3, r3
    cmp constants.w, gt, gt, r1.y
    jmpc cmp.x, eye_zero
    rsq r1.y, r1.y
    mul r3.xyz, r3, r1.y
    cmp r1.y, eq, eq, r1.y
    jmpc cmp.x, eye_ready
eye_zero:
    mov r3.xyz, fallback_eye
eye_ready:
    dp3 r1.z, r2, r3
    mul r4.xyz, constants.z, r2
    mul r4.xyz, r4, r1.z
    add cube.xyz, r4, -r3
    mov cube.w, constants.x
    max r1.z, r1.z, -r1.z
    min r1.z, constants.y, r1.z
    mul r4, delta, r1.z
    add r4, parallel, r4
    max r4, constants.x, r4
    min color, constants.y, r4
    mov maps, v2
    end
.end
