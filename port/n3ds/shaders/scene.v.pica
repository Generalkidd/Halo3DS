; Emit every enabled output lane exactly once on each execution path.
; Native PICA transform for the diagnostic BSP viewer.
.fvec projection[4]
.constf constants(0.0, 0.0, 0.0, 1.0)
.out position position
.out color color
.out texcoord texcoord0
.out cube_coordinate texcoord0w
.out neutral1 texcoord1
.out neutral2 texcoord2
.proc main
    mov r0.xyz, v0
    mov r0.w, constants.w
    dp4 position.x, projection[0], r0
    dp4 position.y, projection[1], r0
    dp4 position.z, projection[2], r0
    dp4 position.w, projection[3], r0
    mov color.xyz, v1
    mov color.w, constants.w
    mov texcoord, v2
    mov cube_coordinate, v2.zzzz
    mov neutral1, v2
    mov neutral2, constants
    end
.end
