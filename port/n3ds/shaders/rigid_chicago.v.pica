; Animated Chicago maps and model skinning in one native vertex pass.
.fvec projection[4]
.fvec bone[3]
.fvec uv_rows[6]
.constf constants(0,0,0,1)
.out position position
.out color color
.out uv0 texcoord0
.out uv1 texcoord1
.out uv2 texcoord2
.proc main
    mov r0.xyz, v0
    mov r0.w, constants.w
    dp4 r1.x, bone[0], r0
    dp4 r1.y, bone[1], r0
    dp4 r1.z, bone[2], r0
    mov r1.w, constants.w
    dp4 position.x, projection[0], r1
    dp4 position.y, projection[1], r1
    dp4 position.z, projection[2], r1
    dp4 position.w, projection[3], r1
    mov color, constants.wwww
    mov r0.xy, v2
    mov r0.zw, constants
    dp4 uv0.x, uv_rows[0], r0
    dp4 uv0.y, uv_rows[1], r0
    mov uv0.zw, constants
    dp4 uv1.x, uv_rows[2], r0
    dp4 uv1.y, uv_rows[3], r0
    mov uv1.zw, constants
    dp4 uv2.x, uv_rows[4], r0
    dp4 uv2.y, uv_rows[5], r0
    mov uv2.zw, constants
    end
.end
